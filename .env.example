NODE_ENV=development

POSTGRES_USER=inrium
POSTGRES_PASSWORD=inrium_password
POSTGRES_DB=inrium

DATABASE_URL=postgresql://inrium:inrium_password@postgres:5432/inrium?schema=public

BACKEND_PORT=4200
FRONTEND_PORT=3000

CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4200/api

JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

SEED_ADMIN_EMAIL=admin@inrium.local
SEED_ADMIN_PASSWORD=Admin12345!
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_DISPLAY_NAME=INRIUM Admin
SEED_EDITOR_EMAIL=editor@inrium.local
SEED_EDITOR_PASSWORD=Editor12345!

# Rate limiting (TTL in milliseconds, LIMIT = max requests per TTL window)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
