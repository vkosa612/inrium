NODE_ENV=development

POSTGRES_USER=inrium
POSTGRES_PASSWORD=inrium_password
POSTGRES_DB=inrium

DATABASE_URL=postgresql://inrium:inrium_password@postgres:5432/inrium?schema=public

BACKEND_PORT=4200
FRONTEND_PORT=3000

# CORS: comma-separated list of allowed origins
# Dev: http://localhost:3000
# Public: http://your-server-ip:3000,https://inrium.ua
CORS_ORIGIN=http://localhost:3000

# API URLs
# NEXT_PUBLIC_API_URL — accessed from browser (must be publicly reachable)
NEXT_PUBLIC_API_URL=http://localhost:4200/api
# NEXT_PUBLIC_SITE_URL — used for SEO canonical URLs / sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000

JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

SEED_ADMIN_EMAIL=admin@inrium.local
SEED_ADMIN_PASSWORD=Admin12345!
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_DISPLAY_NAME=INRIUM Admin
SEED_EDITOR_EMAIL=editor@inrium.local
SEED_EDITOR_PASSWORD=Editor12345!

# Rate limiting (TTL in milliseconds, LIMIT = max requests per TTL window)
# Global
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
# Auth endpoints (login/register/refresh) — overridden in controller

# Feature flags
# Set to false in production to hide Swagger docs
SWAGGER_ENABLED=true

# Docker: bind backend to specific interface
# Dev (public API):  0.0.0.0 (default — backend accessible from LAN)
# Prod (proxy mode): 127.0.0.1 (backend only accessible from host/frontend)
BACKEND_BIND=0.0.0.0
