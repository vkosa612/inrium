# ============================================================================
# INRIUM — приклад змінних середовища.
# Скопіюйте у `.env` (він у .gitignore і НІКОЛИ не комітиться). Значення нижче — лише для локальної
# розробки. Для production використовуйте `.env.production.example` та власні секрети.
# ============================================================================

NODE_ENV=development

# ── База даних ──────────────────────────────────────────────────────────────
POSTGRES_USER=inrium
POSTGRES_PASSWORD=inrium_dev_password
POSTGRES_DB=inrium
# Хост `postgres` — ім'я сервісу в docker compose. Для запуску backend на хості замініть на localhost.
DATABASE_URL=postgresql://inrium:inrium_dev_password@postgres:5432/inrium?schema=public

# ── Порти ───────────────────────────────────────────────────────────────────
BACKEND_PORT=4200
FRONTEND_PORT=3000
# Інтерфейс, на якому слухає frontend: 127.0.0.1 (лише хост / за reverse proxy) або 0.0.0.0 (LAN).
FRONTEND_BIND=127.0.0.1

# ── Адреси та CORS ──────────────────────────────────────────────────────────
# Браузер працює через same-origin `/api` (Next.js проксує на backend) — cookie first-party.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Публічна адреса сайту для посилань у листах (verify/reset).
SITE_URL=http://localhost:3000
# Allowlist origin (через кому, без wildcard). Використовується для CORS та перевірки Origin/Referer (CSRF).
CORS_ORIGIN=http://localhost:3000

# ── Секрети (мін. 32 символи у production; плейсхолдери там відхиляються при старті) ──
# Генерація: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
CSRF_SECRET=change_me_csrf_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Вікно (сек), у яке повторне використання щойно ротованого refresh-токена вважається гонкою вкладок, а не крадіжкою.
REFRESH_REUSE_GRACE_SECONDS=10

# ── Cookie ──────────────────────────────────────────────────────────────────
# У production cookie завжди Secure (COOKIE_SECURE=false там відхиляється).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# ── Reverse proxy / IP клієнта ──────────────────────────────────────────────
# Кількість довірених проксі перед backend (для коректного IP у rate limit).
# 1 — лише Next.js (docker compose за замовчуванням); 2 — nginx/Caddy + Next.js; 0 — backend напряму.
TRUSTED_PROXY_HOPS=1

# ── Rate limit ──────────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ── CAPTCHA (fail-closed) ───────────────────────────────────────────────────
# none | turnstile | hcaptcha | test (test — лише поза production)
CAPTCHA_PROVIDER=none
CAPTCHA_REQUIRED=false
CAPTCHA_SECRET_KEY=
# Публічні параметри віджета (вбудовуються у frontend під час збірки)
NEXT_PUBLIC_CAPTCHA_PROVIDER=
NEXT_PUBLIC_CAPTCHA_SITE_KEY=

# ── Функції ─────────────────────────────────────────────────────────────────
# У production Swagger вимкнений за замовчуванням, а верифікація пошти обов'язкова.
SWAGGER_ENABLED=true
REQUIRE_EMAIL_VERIFICATION=false

# ── Завантаження ────────────────────────────────────────────────────────────
# У Docker перевизначається на /app/uploads (іменований том uploads_data).
UPLOADS_DIR=uploads

# ── Пошта (SMTP) ────────────────────────────────────────────────────────────
# Локально: `docker compose --profile mail up -d mailpit` → SMTP 127.0.0.1:1025, UI http://127.0.0.1:8025.
# Усередині compose-мережі хост — `mailpit`.
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=INRIUM <no-reply@inrium.local>

# ── Seed (лише локально; див. docs/DEPLOYMENT_READINESS.md) ─────────────────
# Поза production без цих змінних створюються демо-акаунти (*.local). Email і пароль задаються ПАРОЮ.
# Seed відмовляється працювати в production без ALLOW_PRODUCTION_SEED=true та надійних паролів.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_EDITOR_EMAIL=
# SEED_EDITOR_PASSWORD=
# ALLOW_PRODUCTION_SEED=false

# ── Публічні контакти / юридичні дані (вбудовуються у frontend під час збірки) ──
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_ADS_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_CONTACT_TELEGRAM=
NEXT_PUBLIC_LEGAL_OPERATOR_NAME=
NEXT_PUBLIC_LEGAL_OPERATOR_ADDRESS=

# ── Логи / моніторинг (необов'язково) ───────────────────────────────────────
LOG_LEVEL=info
ERROR_TRACKING_DSN=
