{
  "name": "inrium",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "fastify": ">=5.12.2 <6",
      "fast-uri": ">=3.1.7 <4",
      "brace-expansion@>=5 <5.0.11": ">=5.0.11",
      "@fastify/busboy": ">=3.2.1 <4",
      "postcss@<8.5.18": ">=8.5.18 <9",
      "js-yaml@>=5 <5.4.1": ">=5.4.1 <6",
      "deepmerge-ts@<8": ">=8.0.0 <9"
    }
  },
  "packageManager": "pnpm@9.15.9"
}
