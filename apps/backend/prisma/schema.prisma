generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  PLAYER
  GAME_MASTER
  EDITOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum ContentType {
  NEWS
  ARTICLE
  GAME_SYSTEM
  KIT
  HELP_PAGE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum HomePageBlockType {
  HERO
  FEATURED_GRID
  LATEST_NEWS
  POPULAR_ARTICLES
  GAMES
  GAME_SYSTEMS
  KITS
  HELP
  CUSTOM
}

enum GameStatus {
  DRAFT
  OPEN
  FULL
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum GameApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REMOVED
}

enum BookmarkTargetType {
  CONTENT
  HELP
  SYSTEM
  KIT
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  displayName  String
  role         UserRole   @default(PLAYER)
  status       UserStatus @default(ACTIVE)

  avatarUrl String?
  bio       String?

  emailVerified              Boolean   @default(false)
  /// sha256 одноразового токена (сам токен у БД не зберігається). Унікальність = швидкий пошук + цілісність.
  emailVerificationToken     String?   @unique
  emailVerificationExpiresAt DateTime?
  passwordResetToken         String?   @unique
  passwordResetExpiresAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contentItems ContentItem[]
  sessions     Session[]
  bookmarks    Bookmark[]
  gamesMastered Game[]              @relation("GameMaster")
  gameApplications GameApplication[]

  @@index([role])
  @@index([status])
}

model Session {
  id               String    @id
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  /// Усі refresh-токени одного входу (ротація) мають спільний familyId.
  familyId         String
  /// Коли цей токен було обміняно на наступний (ротація).
  rotatedAt        DateTime?
  /// id сесії-наступника (для безпечного паралельного refresh у grace-вікні).
  replacedById     String?
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Category {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  type        ContentType?

  contentItems ContentItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id   String @id @default(cuid())
  name String
  slug String @unique

  contentItems ContentTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContentItem {
  id     String        @id @default(cuid())
  type   ContentType
  status ContentStatus @default(DRAFT)

  title   String
  slug    String  @unique
  excerpt String?
  content String

  coverImageUrl  String?
  coverPositionX Float   @default(0.5)
  coverPositionY Float   @default(0.5)
  coverScale     Float   @default(1)
  isFeatured     Boolean @default(false)
  showOnHomePage Boolean @default(false)

  publishedAt DateTime?

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  tags  ContentTag[]
  games Game[]       @relation("GameSystem")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([isFeatured])
  @@index([showOnHomePage])
  @@index([publishedAt])
}

model ContentTag {
  contentItemId String
  tagId         String

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contentItemId, tagId])
}

model HomePageBlock {
  id       String            @id @default(cuid())
  type     HomePageBlockType
  title    String
  subtitle String?
  position Int               @default(0)
  enabled  Boolean           @default(true)
  config   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([enabled])
  @@index([position])
}

model Game {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  description String
  coverImageUrl String?
  coverPositionX Float @default(0.5)
  coverPositionY Float @default(0.5)
  coverScale     Float @default(1)
  status      GameStatus @default(DRAFT)
  maxPlayers  Int?
  startsAt    DateTime?

  masterId String
  master   User   @relation("GameMaster", fields: [masterId], references: [id], onDelete: Cascade)

  systemId String?
  system   ContentItem? @relation("GameSystem", fields: [systemId], references: [id], onDelete: SetNull)

  gameSystemId String?
  gameSystem   GameSystem? @relation(fields: [gameSystemId], references: [id], onDelete: SetNull)

  applications GameApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([startsAt])
  @@index([masterId])
  @@index([gameSystemId])
}

model GameApplication {
  id      String                  @id @default(cuid())
  gameId  String
  game    Game                    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId  String
  user    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  status  GameApplicationStatus   @default(PENDING)
  message String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gameId, userId])
  @@index([gameId])
  @@index([userId])
  @@index([status])
}

// ─── Game Systems ──────────────────────────────────────────────────────────────
// Таблиця Kit збережена без міграції (дані, FK GameSystem, закладки BookmarkTargetType.KIT).
// Каталог наборів вилучено з продукту; DROP TABLE — лише після окремого дозволу.

model GameSystem {
  id               String        @id @default(cuid())
  title            String
  slug             String        @unique
  description      String
  shortDescription String?
  complexity       String?
  genre            String?
  tags             String[]
  imageUrl         String?
  coverPositionX   Float         @default(0.5)
  coverPositionY   Float         @default(0.5)
  coverScale       Float         @default(1)
  status           ContentStatus @default(DRAFT)
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  kits             Kit[]
  games            Game[]

  @@index([status])
}

model Kit {
  id               String        @id @default(cuid())
  title            String
  slug             String        @unique
  description      String
  shortDescription String?
  category         String?
  priceText        String?
  imageUrl         String?
  status           ContentStatus @default(DRAFT)
  publishedAt      DateTime?
  systemId         String?
  system           GameSystem?   @relation(fields: [systemId], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status])
  @@index([systemId])
}

model Bookmark {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType BookmarkTargetType
  targetId   String
  createdAt  DateTime           @default(now())

  @@unique([userId, targetType, targetId])
  @@index([userId])
}

model Community {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String
  coverImageUrl String?
  coverPositionX Float   @default(0.5)
  coverPositionY Float   @default(0.5)
  coverScale     Float   @default(1)
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isPublished])
}
