generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  PLAYER
  GAME_MASTER
  EDITOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum ContentType {
  NEWS
  ARTICLE
  GAME_SYSTEM
  KIT
  HELP_PAGE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum HomePageBlockType {
  HERO
  FEATURED_GRID
  LATEST_NEWS
  POPULAR_ARTICLES
  GAME_SYSTEMS
  KITS
  HELP
  CUSTOM
}

enum GameStatus {
  DRAFT
  OPEN
  FULL
  IN_PROGRESS
  FINISHED
  CANCELLED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  displayName  String
  role         UserRole   @default(PLAYER)
  status       UserStatus @default(ACTIVE)

  avatarUrl String?
  bio       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contentItems ContentItem[]
  sessions     Session[]

  @@index([role])
  @@index([status])
}

model Session {
  id               String    @id
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Category {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  type        ContentType?

  contentItems ContentItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id   String @id @default(cuid())
  name String
  slug String @unique

  contentItems ContentTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContentItem {
  id     String        @id @default(cuid())
  type   ContentType
  status ContentStatus @default(DRAFT)

  title   String
  slug    String  @unique
  excerpt String?
  content String

  coverImageUrl  String?
  isFeatured     Boolean @default(false)
  showOnHomePage Boolean @default(false)

  publishedAt DateTime?

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  tags  ContentTag[]
  games Game[]       @relation("GameSystem")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([isFeatured])
  @@index([showOnHomePage])
  @@index([publishedAt])
}

model ContentTag {
  contentItemId String
  tagId         String

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contentItemId, tagId])
}

model HomePageBlock {
  id       String            @id @default(cuid())
  type     HomePageBlockType
  title    String
  subtitle String?
  position Int               @default(0)
  enabled  Boolean           @default(true)
  config   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([enabled])
  @@index([position])
}

model Game {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  description String
  status      GameStatus @default(DRAFT)
  maxPlayers  Int?
  startsAt    DateTime?

  systemId String?
  system   ContentItem? @relation("GameSystem", fields: [systemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([startsAt])
}

// ─── Game Systems & Kits ───────────────────────────────────────────────────────

model GameSystem {
  id               String        @id @default(cuid())
  title            String
  slug             String        @unique
  description      String
  shortDescription String?
  complexity       String?
  genre            String?
  tags             String[]
  imageUrl         String?
  status           ContentStatus @default(DRAFT)
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  kits             Kit[]

  @@index([status])
}

model Kit {
  id               String        @id @default(cuid())
  title            String
  slug             String        @unique
  description      String
  shortDescription String?
  category         String?
  priceText        String?
  imageUrl         String?
  status           ContentStatus @default(DRAFT)
  publishedAt      DateTime?
  systemId         String?
  system           GameSystem?   @relation(fields: [systemId], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status])
  @@index([systemId])
}
