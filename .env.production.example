# ============================================================================
# INRIUM — ШАБЛОН production-конфігурації. Копіюється у `.env` ЛИШЕ на сервері.
# Усі значення <...> потрібно замінити власними. Реальні секрети НЕ комітяться в репозиторій.
# Backend відмовиться стартувати, якщо секрети — плейсхолдери/коротші за 32 символи,
# CORS_ORIGIN/SITE_URL не https, COOKIE_SECURE=false або REQUIRE_EMAIL_VERIFICATION!=true.
# ============================================================================
NODE_ENV=production

POSTGRES_USER=inrium
POSTGRES_PASSWORD=<згенеруйте-довгий-випадковий-пароль>
POSTGRES_DB=inrium
# Пароль у DATABASE_URL має збігатися з POSTGRES_PASSWORD (спецсимволи — URL-encoded).
DATABASE_URL=postgresql://inrium:<той-самий-пароль>@postgres:5432/inrium?schema=public

FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3000

# Публічна адреса (https). Усі три значення зазвичай однакові.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SITE_URL=https://<your-domain>
SITE_URL=https://<your-domain>
CORS_ORIGIN=https://<your-domain>

# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"  — окремо для КОЖНОГО секрету
JWT_ACCESS_SECRET=<секрет-1-мін-32-символи>
JWT_REFRESH_SECRET=<секрет-2-мін-32-символи>
CSRF_SECRET=<секрет-3-мін-32-символи>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# nginx/Caddy + Next.js = 2; лише Next.js (без проксі) = 1
TRUSTED_PROXY_HOPS=2

THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# CAPTCHA: turnstile | hcaptcha (test у production заборонений)
CAPTCHA_PROVIDER=turnstile
CAPTCHA_REQUIRED=true
CAPTCHA_SECRET_KEY=<secret-key-від-провайдера>
NEXT_PUBLIC_CAPTCHA_PROVIDER=turnstile
NEXT_PUBLIC_CAPTCHA_SITE_KEY=<site-key-від-провайдера>

SWAGGER_ENABLED=false
REQUIRE_EMAIL_VERIFICATION=true

UPLOADS_DIR=/app/uploads

# SMTP реального провайдера (див. docs/EMAIL_PRODUCTION_SETUP.md; SPF/DKIM/DMARC на домені)
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-password>
SMTP_FROM=INRIUM <no-reply@<your-domain>>

NEXT_PUBLIC_CONTACT_EMAIL=<contact@your-domain>
NEXT_PUBLIC_ADS_EMAIL=<ads@your-domain>
NEXT_PUBLIC_PRIVACY_EMAIL=<privacy@your-domain>
NEXT_PUBLIC_CONTACT_TELEGRAM=
NEXT_PUBLIC_LEGAL_OPERATOR_NAME=<повна назва оператора>
NEXT_PUBLIC_LEGAL_OPERATOR_ADDRESS=<адреса оператора>

LOG_LEVEL=info
ERROR_TRACKING_DSN=
