# Приклад reverse proxy (nginx) для production INRIUM.
# Весь публічний трафік іде ЛИШЕ на frontend (127.0.0.1:3000): він сам проксує /api/* та /uploads/* на backend
# усередині docker-мережі. Backend і PostgreSQL назовні не публікуються.
#
# Топологія: клієнт → nginx → Next.js (frontend) → backend  ⇒ у .env встановіть TRUSTED_PROXY_HOPS=2.
# (nginx додає реальний IP клієнта в X-Forwarded-For, Next.js додає IP nginx — backend бере IP на 2 хопи від кінця.)

upstream inrium_frontend {
    server 127.0.0.1:3000;
    keepalive 16;
}

# Обмеження частоти на рівні проксі — додатковий шар поверх rate limit у застосунку.
limit_req_zone $binary_remote_addr zone=inrium_auth:10m rate=10r/m;

server {
    listen 443 ssl;
    http2 on;
    server_name inrium.example.com;

    ssl_certificate     /etc/letsencrypt/live/inrium.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/inrium.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Узгоджено з лімітом завантаження зображень у застосунку (5 МБ + multipart-обгортка).
    client_max_body_size 6m;
    server_tokens off;

    # HSTS вмикайте лише після перевірки, що HTTPS працює стабільно.
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Чутливі auth-ендпоінти: додаткове обмеження на рівні nginx.
    location ~ ^/api/auth/(login|register|resend-verification|request-password-reset|reset-password)$ {
        limit_req zone=inrium_auth burst=10 nodelay;
        proxy_pass http://inrium_frontend;
        include /etc/nginx/inrium-proxy.conf;
    }

    location / {
        proxy_pass http://inrium_frontend;
        include /etc/nginx/inrium-proxy.conf;
    }
}

server {
    listen 80;
    server_name inrium.example.com;
    return 301 https://$host$request_uri;
}

# ── /etc/nginx/inrium-proxy.conf ────────────────────────────────────────────
